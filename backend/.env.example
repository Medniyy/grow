# Copy to `backend/.env` (gitignored) for local runs. Railway does not read that
# file — the deployed service takes its values from Railway variables, and a real
# environment variable always wins over the file.

# The Solana node every chain read in Grow goes through.
#
# ⚠️ NOT OPTIONAL FOR A DEPLOYMENT. The fallback is
# `api.mainnet-beta.solana.com`, which refuses the connection from Railway
# outright — `fetch failed`, no HTTP response, while the identical call from a
# laptop returns 200. Public Solana endpoints block cloud egress ranges. Unset,
# the portfolio, the Grow Account balance and every confirmation fail together
# and the app shows an empty wallet.
#
#   https://mainnet.helius-rpc.com/?api-key=<key>     free tier is enough
SOLANA_RPC_URL=

# Production DFlow key. Without it the proxy falls back to the keyless developer
# endpoint, which also serves mainnet. Request a key at:
#   https://pond.dflow.net/get-started/api-key   (2-5 day turnaround)
DFLOW_API_KEY=

# Lock this to the deployed web origin before any public demo.
ALLOWED_ORIGIN=*
