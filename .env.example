# Only EXPO_PUBLIC_* variables reach the client, and they are inlined into the
# bundle at build time. Nothing secret may live here — the DFlow production key
# stays behind the backend proxy (SPEC §13).
#
# ⚠️ AFTER EDITING ANY VALUE HERE, REBUILD WITH `--clear`:
#
#     npx expo export --platform web --clear
#
# These are inlined by Metro at TRANSFORM time, and changing one does NOT
# invalidate Metro's transform cache. A plain rebuild silently keeps the OLD
# value and reports success — measured 2026-08-30, when a rebuild after pointing
# the app at the Railway proxy produced a byte-identical bundle still calling the
# dev endpoint direct. The same applies to `npx expo start -c`.

# Railway proxy. Deployed and keyless — it forwards to DFlow's developer
# endpoint, which also serves mainnet. Empty makes the app call that endpoint
# directly, which works locally but has no CORS story in production.
EXPO_PUBLIC_API_BASE_URL=https://grow-proxy-production.up.railway.app

# A public RPC is rate-limited and will feel slow. Use your own for the demo.
EXPO_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Rehearsal: run the whole money flow against the mock swap port, spending
# nothing. Use this for every practice run (Q14).
EXPO_PUBLIC_MOCK_SWAP=0

# Seeds the LOCAL ledger to a larger state for the near-miss demo moment.
# Emits no real events and moves no real money.
EXPO_PUBLIC_DEMO_MODE=0

# Permission to fall back to DFlow's keyless developer endpoint when no proxy
# is configured above. Off by default: that endpoint is rate-limited and
# unkeyed, and falling back to it silently is how a production build ends up
# pointed at it with nothing on screen to say so. Set to 1 for local work
# without a proxy; leave it out of any build that goes in front of people.
EXPO_PUBLIC_ALLOW_DEV_ENDPOINT=0
